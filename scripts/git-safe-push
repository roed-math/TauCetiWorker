#!/usr/bin/env bash
# git-safe-push — the ONLY sanctioned way to push a Tau Ceti PR branch.
#
# This is the [HARD] write arbiter (coordination contract §1): every PR-branch update goes through a
# branch-level compare-and-swap, so we NEVER silently overwrite another agent's work — cooperating or
# not — and we detect the race and bail. It does NOT depend on anyone honoring claims.
#
#   git push --force-with-lease=<ref>:<expected>  origin HEAD:<ref>
#     expected = <oid>  → succeeds iff the remote branch still equals the oid we observed at checkout
#     expected = ""     → create-only (succeeds iff the branch does not exist) — for authoring
#
# If a claim is in play, it is re-checked/renewed immediately before the push and the push FAILS CLOSED
# if the lease was lost (someone took over). The claim is [COOP] (avoids duplicate work); the branch CAS
# is what actually protects the write.
#
# Inputs (exported by the worker before it launches the agent; the agent just runs `git-safe-push [<branch>]`):
#   TAUCETI_PUSH_REF     destination branch on the head repo (or pass as $1)
#   TAUCETI_PUSH_EXPECT  observed remote head oid; empty/unset ⇒ create-only (new branch)
#   TAUCETI_PUSH_REMOTE  git remote or URL to push to (default: origin)
#   TAUCETI_CLAIM_KEY    optional claim key to verify/renew before pushing
#   TAUCETI_CLAIM_REPO   repository containing that claim (default: claim.sh's normal selection)
#   TAUCETI_CLAIM_SH     path to claim.sh (default: alongside this script)
#   TAUCETI_GATE_DIR / TAUCETI_GATE_REQUIRED   the fleet GitHub gate (docs/gate.md): the push is admitted
#                        as a git_push to the head repository before git runs and recorded after
#   TAUCETI_REAL_GIT     the git to run (the agent's PATH leads with a shim of it)
#   TAUCETI_LOOKAHEAD_BRANCH set by a lookahead round (tauceti_worker/lookahead.py): the ONLY branch it may push.
#                        Every other round refuses to push a lookahead/* branch, or any HEAD that carries the
#                        stubs (TauCeti/Lookahead/ or LOOKAHEAD.md), so a stub can never reach a pull request.
#   TAUCETI_PUBLICATION_ID   the round's publication (docs/gate.md, design §6): the push is its `push` step,
#                        marked sent before git runs and done with the pushed tip after; a step already
#                        sent/uncertain/done, a moved PR head (fix/rebase) or a publication that needs
#                        reconciliation is refused (exit 75) and NOTHING is pushed
set -uo pipefail
# shellcheck source=gate-lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/gate-lib.sh"
REAL_GIT="${TAUCETI_REAL_GIT:-git}"

REF="${1:-${TAUCETI_PUSH_REF:-}}"
EXPECT="${TAUCETI_PUSH_EXPECT:-}"
REMOTE="${TAUCETI_PUSH_REMOTE:-origin}"
CLAIM_KEY="${TAUCETI_CLAIM_KEY:-}"
CLAIM_REPO_OVERRIDE="${TAUCETI_CLAIM_REPO:-}"
CLAIM_SH="${TAUCETI_CLAIM_SH:-$(cd "$(dirname "$0")" && pwd)/claim.sh}"

die() { echo "git-safe-push: $*" >&2; exit 1; }
claim() {
    if [[ -n "$CLAIM_REPO_OVERRIDE" ]]; then
        CLAIM_REPO="$CLAIM_REPO_OVERRIDE" "$CLAIM_SH" "$@"
    else
        "$CLAIM_SH" "$@"
    fi
}
[[ -n "$REF" ]] || die "no destination branch (set TAUCETI_PUSH_REF or pass it as an argument)"

LOOKAHEAD_BRANCH="${TAUCETI_LOOKAHEAD_BRANCH:-}"
if [[ -n "$LOOKAHEAD_BRANCH" ]]; then
    [[ "$REF" == "$LOOKAHEAD_BRANCH" ]] || {
        echo "git-safe-push: a lookahead round pushes only '$LOOKAHEAD_BRANCH', not '$REF' — nothing was pushed" >&2; exit 75; }
else
    [[ "$REF" != lookahead/* ]] || {
        echo "git-safe-push: only a lookahead round pushes a lookahead/ branch — nothing was pushed" >&2; exit 75; }
    if [[ -n "$("$REAL_GIT" ls-tree -r --name-only HEAD -- TauCeti/Lookahead LOOKAHEAD.md 2>/dev/null)" ]]; then
        echo "git-safe-push: HEAD carries lookahead stubs (TauCeti/Lookahead/ or LOOKAHEAD.md), which never go into a pull request branch — nothing was pushed" >&2
        exit 75
    fi
fi

# 1) Lease check (fail closed if we no longer hold the claim someone may have taken over).
if [[ -n "$CLAIM_KEY" && -x "$CLAIM_SH" ]]; then
    if ! claim holds "$CLAIM_KEY"; then
        claim renew "$CLAIM_KEY" >/dev/null 2>&1 \
            || die "lease '$CLAIM_KEY' lost (another agent took over) — refusing to push"
    fi
fi

TARGET="$REMOTE"
case "$REMOTE" in
    http://*|https://*|git@*|ssh://*) ;;
    *) TARGET=$("$REAL_GIT" remote get-url "$REMOTE" 2>/dev/null || echo "$REMOTE");;
esac

# 2) Where the branch really is. Normally at the head the round checked out (EXPECT). One exception is
#    not a race: an earlier push of ours reached the branch, but GitHub never moved the pull request's
#    head to it (2026-09-30, #10130: the branch was at 28fa8d5 while the PR still said 40be938), so every
#    later round leased on the PR's stale head and was refused as "stale info". When HEAD already
#    contains the branch's real tip, pushing over it loses nobody's work: lease on that tip instead. If
#    the tip IS HEAD, git would report "Everything up-to-date" and the PR would stay behind, so an empty
#    commit goes on top: only a new push makes GitHub update the pull request. A tip HEAD does not
#    contain is a real race; the lease on EXPECT below refuses it as before. One gated read.
LEASE="$EXPECT"
if [[ -n "$EXPECT" ]]; then
    gate_admit git_read ls-remote "$TARGET" || { echo "git-safe-push: the fleet gate refused reading the branch — nothing was pushed" >&2; exit 75; }
    ACTUAL=$("$REAL_GIT" ls-remote "$REMOTE" "refs/heads/$REF" 2>/dev/null | cut -f1)
    if [[ -n "$ACTUAL" ]]; then gate_record ok; else gate_record fail; fi
    if [[ -n "$ACTUAL" && "$ACTUAL" != "$EXPECT" ]]; then
        if ! "$REAL_GIT" cat-file -e "$ACTUAL^{commit}" 2>/dev/null; then
            gate_admit git_read fetch "$TARGET" || exit 75
            "$REAL_GIT" fetch -q "$REMOTE" "refs/heads/$REF" 2>/dev/null
            gate_record ok
        fi
        if "$REAL_GIT" merge-base --is-ancestor "$ACTUAL" HEAD 2>/dev/null; then
            if [[ "$ACTUAL" == "$("$REAL_GIT" rev-parse HEAD)" ]]; then
                # The identity of the commit already on top, when git has none configured here.
                name=$("$REAL_GIT" config user.name || "$REAL_GIT" log -1 --format=%an)
                email=$("$REAL_GIT" config user.email || "$REAL_GIT" log -1 --format=%ae)
                "$REAL_GIT" -c "user.name=$name" -c "user.email=$email" commit -q --allow-empty \
                    -m "chore: re-sync the pull request's head" \
                    -m "An earlier push of ${ACTUAL:0:12} reached the branch, but GitHub did not move the pull request's head to it. This empty commit is a new push, which does." \
                    || die "could not make the re-sync commit — nothing was pushed"
            fi
            echo "git-safe-push: '$REF' is at ${ACTUAL:0:12}, not the pull request's ${EXPECT:0:12}, and HEAD already contains it (an earlier push the pull request never picked up); leasing on the branch's tip" >&2
            LEASE="$ACTUAL"
        fi
    fi
fi

# 3) The gate: one git_push to the head repository (a remote NAME was resolved to its URL above, so the
#    target is the repository, not the alias); a refusal is final for this round (exit 75, nothing pushed).
gate_admit git_push push "$TARGET" || { echo "git-safe-push: the fleet gate refused this push — nothing was pushed" >&2; exit 75; }

# 3b) The publication ledger: this push is the `push` step. The ledger revalidates the PR head (one read)
#     and refuses a step that was already sent; refused, nothing is pushed and the round yields.
LOCAL_TIP=$("$REAL_GIT" rev-parse HEAD 2>/dev/null || echo "")
if ! pub_begin push --sha "$LOCAL_TIP" --branch "$REF"; then
    gate_record fail
    echo "git-safe-push: the publication ledger refused this push — nothing was pushed" >&2
    exit 75
fi

# 4) Branch-level CAS push. lease="" ⇒ create-only; else the branch must still be at that oid.
echo "git-safe-push: $REMOTE HEAD:$REF (--force-with-lease=$REF:${LEASE:-<create-only>})" >&2
OUT=$(mktemp)
"$REAL_GIT" push --force-with-lease="$REF:$LEASE" "$REMOTE" "HEAD:$REF" 2> >(tee "$OUT" >&2)
rc=$?
wait
if [[ "$rc" -eq 0 ]]; then gate_record ok "$OUT"; else gate_record "rc:$rc" "$OUT"; fi
if [[ "$rc" -eq 0 ]]; then pub_end push ok --remote-id "$LOCAL_TIP" --detail-file "$OUT"; else pub_end push fail --detail-file "$OUT"; fi
rm -f "$OUT"
[[ "$rc" -eq 0 ]] && exit 0
die "push rejected — the branch '$REF' moved since checkout (a concurrent push), or it already exists.
This is the safety mechanism working: we did NOT overwrite anyone. Re-sync to the current head and retry
next round; do not retry a plain 'git push'."
