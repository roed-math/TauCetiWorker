#!/usr/bin/env python3
"""Print the newest commit on a ref whose Lake outputs a cache service publishes.

    main-cache-rev --service NAME --repo OWNER/NAME [--ref origin/main] [--max N] [--deadline S]

`lake cache get` looks for outputs by walking back from HEAD. Before the merge of `main` into an older
branch is committed, HEAD is still the branch, so the walk restores outputs from the branch's own base
and the build then compiles everything `main` changed since. This walks the ref's first-parent history
instead, asking the service's revision endpoint for each commit's mapping the way Lake would, so the
caller can run `lake cache get --rev=<commit>` for it.

The endpoint comes from Lake's system configuration (`$LAKE_CONFIG`, else `~/.lake/config.toml`), which
Bubble writes for the container. Exit 0 with the commit on stdout; 1 when no commit within --max (or
before --deadline) has outputs; 2 when the service cannot be asked.
"""

import argparse
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def revision_endpoint(config_text, service):
    for block in re.split(r"(?m)^\s*\[\[cache\.service\]\]\s*$", config_text)[1:]:
        block = re.split(r"(?m)^\s*\[", block)[0]
        fields = dict(re.findall(r'(?m)^\s*([A-Za-z]+)\s*=\s*"([^"]*)"', block))
        if fields.get("name") == service:
            return fields.get("revisionEndpoint")
    return None


def toolchain_dir(toolchain):
    # Lake's toolchain2Dir: the path segment its s3 revision URLs carry under `tc/`.
    return toolchain.replace("/", "--").replace(":", "---")


def uri_segment(component):
    return urllib.parse.quote(component, safe="-_.~")


def revision_url(endpoint, repo, toolchain, rev):
    url = endpoint.rstrip("/")
    for component in repo.split("/"):
        url += "/" + uri_segment(component)
    if toolchain:
        url += "/tc/" + uri_segment(toolchain_dir(toolchain))
    return url + "/" + rev + ".jsonl"


def published(url):
    """True for a mapping the service holds, False for one it does not; raises when it cannot say."""
    request = urllib.request.Request(url, headers={"User-Agent": "tauceti-worker main-cache-rev"})
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return response.status == 200
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return False
        raise


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--service", required=True)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--ref", default="origin/main")
    parser.add_argument("--max", type=int, default=800)
    parser.add_argument("--deadline", type=float, default=180)
    args = parser.parse_args()

    config = os.environ.get("LAKE_CONFIG") or os.path.expanduser("~/.lake/config.toml")
    try:
        with open(config) as f:
            endpoint = revision_endpoint(f.read(), args.service)
    except OSError as e:
        print(f"main-cache-rev: cannot read Lake config {config}: {e}", file=sys.stderr)
        return 2
    if not endpoint:
        print(f"main-cache-rev: no revisionEndpoint for service {args.service!r} in {config}", file=sys.stderr)
        return 2

    def git(*argv):
        return subprocess.run(["git", *argv], capture_output=True, text=True, check=True).stdout

    try:
        toolchain = git("show", f"{args.ref}:lean-toolchain").strip()
        revs = git("rev-list", "--first-parent", f"--max-count={args.max}", args.ref).split()
    except subprocess.CalledProcessError as e:
        print(f"main-cache-rev: cannot read {args.ref}: {e.stderr.strip()}", file=sys.stderr)
        return 2

    stop = time.monotonic() + args.deadline
    for checked, rev in enumerate(revs, 1):
        if time.monotonic() > stop:
            print(f"main-cache-rev: no published outputs in the {checked - 1} newest commits of {args.ref} "
                  f"checked within {args.deadline:g}s", file=sys.stderr)
            return 1
        url = revision_url(endpoint, args.repo, toolchain, rev)
        try:
            found = published(url)
        except (urllib.error.URLError, OSError) as first:
            try:
                found = published(url)
            except (urllib.error.URLError, OSError) as e:
                print(f"main-cache-rev: the service did not answer for {rev} ({first}; then {e})", file=sys.stderr)
                return 2
        if found:
            print(rev)
            print(f"main-cache-rev: {rev} is the newest of {args.ref}'s commits with published outputs "
                  f"({checked - 1} newer ones have none)", file=sys.stderr)
            return 0
    print(f"main-cache-rev: no published outputs in the {len(revs)} newest commits of {args.ref}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
