#!/usr/bin/env bash
# gh-safe-pr-create — the ONLY sanctioned way to open a Tau Ceti PR (authoring path).
#
# Verifies the author target claim is still held (fail closed if another agent took the target), then
# runs `gh pr create` with the given args. The branch must already have been pushed via git-safe-push
# (which create-only-pushes it, so two agents can't both create the same branch). It also checks the
# PR body carries the machine-readable target marker the dup-sweeper relies on (coordination contract §4).
#
# Inputs:
#   TAUCETI_AUTHOR_CLAIM_KEY   the author/<area>/<target-id> claim acquired in shell before the agent ran
#   TAUCETI_TARGET_MARKER      the exact <!--tauceti-target:v1 {...}--> string the PR body must contain
#   TAUCETI_CLAIM_SH           path to claim.sh (default: alongside this script)
#   TAUCETI_GATE_DIR / TAUCETI_GATE_REQUIRED   the fleet GitHub gate (docs/gate.md): the create is admitted
#                              as one api_mutation (op pr_create) against --repo before gh runs
#   TAUCETI_REAL_GH            the gh to run (the agent's PATH leads with a shim of it)
#   TAUCETI_PUBLICATION_ID     the round's publication (docs/gate.md, design §6): the create is its
#                              `pr_create` step. The publication's hidden marker is appended to the body
#                              (so a lost response can be reconciled by it), the step is marked sent before
#                              gh runs and done with the PR number after; a step already sent/uncertain/done
#                              is refused (exit 75) and NOTHING is created.
# All `gh pr create` flags pass through unchanged (the body file is rewritten to carry the marker).
set -uo pipefail
# shellcheck source=gate-lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/gate-lib.sh"
REAL_GH="${TAUCETI_REAL_GH:-gh}"

CLAIM_KEY="${TAUCETI_AUTHOR_CLAIM_KEY:-}"
MARKER="${TAUCETI_TARGET_MARKER:-}"
REQUIRE_MARKER="${TAUCETI_REQUIRE_TARGET_MARKER:-}"   # 1 ⇒ body must carry SOME <!--tauceti-target--> marker
CLAIM_SH="${TAUCETI_CLAIM_SH:-$(cd "$(dirname "$0")" && pwd)/claim.sh}"

die() { echo "gh-safe-pr-create: $*" >&2; exit 1; }

# extract the PR body from the passed `gh pr create` flags (--body/-b <s>, --body-file/-F <f>).
pr_body_from_args() {
    local b="" prev=""
    for a in "$@"; do
        case "$prev" in
            --body|-b) b="$a";;
            --body-file|-F) [[ -f "$a" ]] && b="$(cat "$a")";;
        esac
        prev="$a"
    done
    printf '%s' "$b"
}

# 1) Author claim must still be ours (else another agent is authoring this target — abandon).
if [[ -n "$CLAIM_KEY" && -x "$CLAIM_SH" ]]; then
    "$CLAIM_SH" holds "$CLAIM_KEY" \
        || die "author lease '$CLAIM_KEY' lost (another agent took the target) — do NOT create the PR"
fi

# 2) The PR body must carry the target marker so the conservative dup-sweeper can match it.
#    Either an EXACT marker is mandated (TAUCETI_TARGET_MARKER, when the shell pre-picked the target),
#    or just SOME well-formed marker is required (TAUCETI_REQUIRE_TARGET_MARKER, agent-picked target).
if [[ -n "$MARKER" ]]; then
    body="$(pr_body_from_args "$@")"
    [[ "$body" == *"$MARKER"* ]] \
        || die "PR body is missing the required target marker:
  $MARKER
Add it to the PR body (it lets other agents and the dup-sweeper recognize this target)."
elif [[ "$REQUIRE_MARKER" == "1" ]]; then
    body="$(pr_body_from_args "$@")"
    grep -qE '<!--tauceti-target:v1 \{[^}]*"id"[[:space:]]*:[[:space:]]*"[^"]+"[^}]*\}-->' <<<"$body" \
        || die "PR body is missing a target marker. Add a line like:
  <!--tauceti-target:v1 {\"focus\":\"<area>\",\"id\":\"<slug>\"}-->
It lets other agents and the dup-sweeper recognize which roadmap target this PR authors."
fi

# 3) The gate: one mutation against the base repository (--repo/-R, else canonical).
TARGET="TauCetiProject/TauCeti"; prev=""
for a in "$@"; do
    case "$prev" in --repo|-R) TARGET="$a";; esac
    case "$a" in --repo=*) TARGET="${a#--repo=}";; esac
    prev="$a"
done
# 3b) The publication ledger: embed the publication's marker in the body so the PR can be found by it
#     if the response is lost, then mark the `pr_create` step sent. A refused step creates nothing.
if pub_enabled; then
    PUB_MARKER="<!--tauceti-publication:v1 {\"id\":\"$TAUCETI_PUBLICATION_ID\"}-->"
    args=(); prev=""; injected=0
    for a in "$@"; do
        case "$prev" in
            --body|-b) a="$a"$'\n\n'"$PUB_MARKER"; injected=1;;
            --body-file|-F)
                if [[ -f "$a" ]] && ! grep -qF "$PUB_MARKER" "$a"; then printf '\n\n%s\n' "$PUB_MARKER" >> "$a"; fi
                injected=1;;
        esac
        args+=("$a"); prev="$a"
    done
    [[ "$injected" == 1 ]] || args+=(--body "$PUB_MARKER")
    set -- "${args[@]}"
fi
gate_admit api_mutation pr_create "$TARGET" || die "the fleet gate refused this PR creation — nothing was created"
if ! pub_begin pr_create; then
    gate_record fail
    echo "gh-safe-pr-create: the publication ledger refused this PR creation — nothing was created" >&2
    exit 75
fi

echo "gh-safe-pr-create: gh pr create $*" >&2
OUT=$(mktemp); STDOUT=$(mktemp)
gate_spawn "$REAL_GH" pr create "$@"
"$REAL_GH" pr create "$@" 2> >(tee "$OUT" >&2) | tee "$STDOUT"
rc=${PIPESTATUS[0]}
wait
if [[ "$rc" -eq 0 ]]; then gate_record ok "$OUT"; else gate_record "rc:$rc" "$OUT"; fi
# `done` only when the response named the PR: a success whose number cannot be parsed is `uncertain`,
# for `tauceti-gate reconcile` to find by the marker (never re-created here).
PRNUM=$(grep -oE '/pull/[0-9]+' "$STDOUT" | head -1 | grep -oE '[0-9]+' || true)
if [[ "$rc" -eq 0 && -n "$PRNUM" ]]; then
    pub_end pr_create ok --remote-id "$PRNUM" --detail-file "$OUT"
    pub_end marker_check ok --remote-id "$PRNUM" --detail "verified locally before the create"
elif [[ "$rc" -eq 0 ]]; then
    pub_end pr_create ok --detail-file "$OUT"
else
    pub_end pr_create fail --detail-file "$OUT"
fi
rm -f "$OUT" "$STDOUT"
exit "$rc"